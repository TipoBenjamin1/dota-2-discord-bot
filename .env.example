DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id

# Optional. If set, slash commands update instantly only in this server.
# If empty, commands are registered globally and can take time to appear.
DISCORD_GUILD_ID=

# Bot refreshes OpenDota data in the background.
DATA_REFRESH_INTERVAL_MINUTES=60

# Optional. Channel where the bot posts Dota 2 patch announcements.
PATCH_ANNOUNCE_CHANNEL_ID=

# Optional. Checks Steam News for a new Dota 2 patch every N minutes.
PATCH_CHECK_INTERVAL_MINUTES=30

# Optional. How many @everyone mentions to send for a new patch. Max: 3.
PATCH_MENTION_COUNT=3

# Optional. true = announce the currently latest patch on first start.
# false = remember current patch silently and announce only future patches.
PATCH_ANNOUNCE_ON_FIRST_START=false
